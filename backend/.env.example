# --- Core ---
APP_NAME=Enterprise AI Personal Agent
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- Firebase Auth ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google OAuth (Gmail / Calendar / Drive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback
GOOGLE_POST_AUTH_REDIRECT_URL=http://localhost:3000/dashboard/settings?google=connected
GOOGLE_POST_AUTH_ERROR_REDIRECT_URL=http://localhost:3000/dashboard/settings?google=error

# --- Token security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# --- AI Providers ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# --- Utilities ---
WEATHER_API_KEY=
WEB_SEARCH_API_KEY=

# --- Voice AI (Google Cloud Speech-to-Text / Text-to-Speech) ---
# These clients authenticate via Application Default Credentials. Set this to
# the path of a GCP service account JSON key with Speech-to-Text and
# Text-to-Speech API access (see docs/GOOGLE_CLOUD_SETUP.md).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_STT_LANGUAGE_CODE=en-US

# --- File / Storage ---
SUPABASE_STORAGE_BUCKET=user-uploads
MAX_UPLOAD_BYTES=20971520

# --- Security ---
JWT_ALGORITHM=RS256
RATE_LIMIT_PER_MINUTE=60
